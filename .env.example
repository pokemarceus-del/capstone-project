# Core
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
JWT_ISSUER=aquaflow
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEYS_JSON=
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=
AUTH_NODE_ENV=development
AUTH_SEED_LOCAL_IDENTITIES=false
AUTH_SEED_BILLING_OFFICER_EMAIL=
AUTH_SEED_BILLING_OFFICER_PASSWORD=
AUTH_SEED_METER_READER_EMAIL=
AUTH_SEED_METER_READER_PASSWORD=
AUTH_SEED_CUSTOMER_EMAIL=
AUTH_SEED_CUSTOMER_PASSWORD=

# Database
POSTGRES_USER=aquaflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=customer_db
CUSTOMER_DATABASE_URL=postgresql://aquaflow:change-me@postgres:5432/customer_db?schema=public
CUSTOMER_SEED_DEMO=true

# Auth database
AUTH_POSTGRES_USER=aquaflow_auth
AUTH_POSTGRES_PASSWORD=change-me
AUTH_POSTGRES_DB=auth_db
AUTH_DATABASE_URL=postgresql://aquaflow_auth:change-me@auth-postgres:5432/auth_db?schema=public
AUTH_INTEGRATION_DATABASE_URL=
CUSTOMER_SERVICE_URL=http://customer:3001

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# App web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
