# Copy to .env in this directory and replace every placeholder locally.
# Never commit .env or print its contents.
jwt-active-kid=replace-with-key-id
jwt-private-key-b64=replace-with-base64-encoded-private-key
jwt-public-keys-json={"keys":[]}
auth-database-url=postgresql://replace-user:replace-password@auth-postgres:5432/auth
billing-database-url=postgresql://replace-user:replace-password@billing-postgres:5432/billing
customer-database-url=postgresql://replace-user:replace-password@customer-postgres:5432/customer
reading-database-url=postgresql://replace-user:replace-password@reading-postgres:5432/reading
redis-url=redis://replace-password@redis-master:6379
rabbitmq-url=amqp://replace-user:replace-password@rabbitmq:5672
minio-access-key=replace-access-key
minio-secret-key=replace-secret-key
